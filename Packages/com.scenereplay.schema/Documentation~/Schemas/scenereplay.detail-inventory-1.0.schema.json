{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/SceneReplay/v0.1.0/Packages/com.scenereplay.schema/Documentation~/Schemas/scenereplay.detail-inventory-1.0.schema.json",
  "title": "SceneReplay Detail Inventory 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "details"],
  "properties": {
    "schema": { "const": "scenereplay.detail-inventory/1.0" },
    "subject": { "type": "string", "minLength": 1 },
    "details": { "type": "array", "items": { "$ref": "#/$defs/detail" } }
  },
  "$defs": {
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "parentId", "targetNodeId", "required", "repeatCount", "confidence", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "parentId": { "type": "string" },
        "targetNodeId": { "type": "string" },
        "required": { "type": "boolean" },
        "repeatCount": { "type": "integer", "minimum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
