{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/SceneReplay/v0.1.0/Packages/com.scenereplay.schema/Documentation~/Schemas/scenereplay.style-1.0.schema.json",
  "title": "SceneReplay Style Definition 1.0",
  "description": "An engine-agnostic semantic color style.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "palette"],
  "properties": {
    "schema": { "const": "scenereplay.style/1.0" },
    "id": { "type": "string", "minLength": 1 },
    "baseStyle": { "type": "string" },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/paletteEntry" }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "type": "number", "minimum": 0, "maximum": 1 },
        "g": { "type": "number", "minimum": 0, "maximum": 1 },
        "b": { "type": "number", "minimum": 0, "maximum": 1 },
        "a": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "paletteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "color"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/$defs/color" }
      }
    }
  }
}
