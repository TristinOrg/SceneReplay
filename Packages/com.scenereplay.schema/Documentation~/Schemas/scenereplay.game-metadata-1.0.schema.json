{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/SceneReplay/v0.1.0/Packages/com.scenereplay.schema/Documentation~/Schemas/scenereplay.game-metadata-1.0.schema.json",
  "title": "SceneReplay Game Metadata 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "anchors", "damageZones", "colliders", "lods", "tags"],
  "properties": {
    "schema": { "const": "scenereplay.game-metadata/1.0" },
    "id": { "type": "string", "minLength": 1 },
    "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
    "damageZones": { "type": "array", "items": { "$ref": "#/$defs/damageZone" } },
    "colliders": { "type": "array", "items": { "$ref": "#/$defs/collider" } },
    "lods": { "type": "array", "items": { "$ref": "#/$defs/lod" } },
    "tags": { "$ref": "#/$defs/tags" }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "eulerAngles", "scale"],
      "properties": {
        "position": { "$ref": "#/$defs/vector" },
        "eulerAngles": { "$ref": "#/$defs/vector" },
        "scale": { "$ref": "#/$defs/vector" }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "nodeId", "transform", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "transform": { "$ref": "#/$defs/transform" },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "damageZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeId", "multiplier", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "multiplier": { "type": "number", "minimum": 0 },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "collider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeId", "kind", "isTrigger", "center", "size", "radius", "height"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["box", "sphere", "capsule", "mesh"] },
        "isTrigger": { "type": "boolean" },
        "center": { "$ref": "#/$defs/vector" },
        "size": { "$ref": "#/$defs/vector" },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "screenRelativeHeight", "nodeIds"],
      "properties": {
        "level": { "type": "integer", "minimum": 0 },
        "screenRelativeHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
