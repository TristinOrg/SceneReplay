{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/SceneReplay/v0.1.0/Packages/com.scenereplay.schema/Documentation~/Schemas/scenereplay.construction-plan-1.0.schema.json",
  "title": "SceneReplay Construction Plan 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "baseRevision", "passes"],
  "properties": {
    "schema": { "const": "scenereplay.construction-plan/1.0" },
    "id": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "string" },
    "passes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pass" } }
  },
  "$defs": {
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "state", "dependsOn", "patch", "qualityPolicyId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["structure", "primaryForms", "secondaryForms", "details", "appearance", "gameplaySemantics", "finalQuality"] },
        "state": { "enum": ["pending", "inProgress", "completed", "failed", "skipped"] },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "patch": { "$ref": "scenereplay.patch-1.0.schema.json" },
        "qualityPolicyId": { "type": "string" }
      }
    }
  }
}
