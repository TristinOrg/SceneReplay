{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/SceneReplay/v0.1.0/Packages/com.scenereplay.schema/Documentation~/Schemas/scenereplay.adapter-1.0.schema.json",
  "title": "SceneReplay Adapter Descriptor 1.0",
  "description": "Declares an engine adapter's identity, supported semantic features, and unsupported-feature behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapterId", "engineId", "version", "features", "unsupportedFeaturePolicy"],
  "properties": {
    "schema": { "const": "scenereplay.adapter/1.0" },
    "adapterId": { "type": "string", "minLength": 1 },
    "engineId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unsupportedFeaturePolicy": {
      "enum": ["reject", "preserveAsMetadata", "warnAndSkip"]
    }
  }
}
